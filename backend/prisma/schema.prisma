generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEV
  ADMIN
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  passwordHash      String
  role              Role               @default(ADMIN)
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Customer {
  id              String               @id @default(uuid())
  phone           String               @unique
  name            String
  pinHash         String?
  imageUrl        String?
  medicalNotes    String?
  isFrequent      Boolean              @default(false)              
  loyalityPoints Int                  @default(0)
  appointments    Appointment[]
  frequencies     ServiceFrecuencies[]
  pushSubscriptions PushSubscription[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Service {
  id                    String               @id @default(uuid())
  title                 String
  description           String?
  price                 Decimal              @db.Decimal(10, 2)
  advancePaymentPercent Float                @default(0.20)
  durationMin           Int
  category              String
  imageUrl              String?
  isActive              Boolean              @default(true)
  isPromotion           Boolean              @default(false)
  highlightPriority     Int                  @default(0)
  appointments          Appointment[]
  frequencies           ServiceFrecuencies[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model ServiceFrecuencies {
  id         String   @id @default(uuid())
  customerId String
  serviceId  String
  count      Int      @default(1)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId])
}

model Appointment {
  id                   String            @id @default(uuid())
  folio                String            @unique @default(cuid())
  startTime            DateTime
  endTime              DateTime
  status               AppointmentStatus @default(PENDING)
  notes                String?
  advancePaymentAmount Decimal           @default(0.00) @db.Decimal(10, 2)
  advancePaid          Boolean           @default(false)
  hasRescheduled       Boolean           @default(false)
  advanceRetained      Boolean           @default(false)
  
  customerId           String
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  serviceId            String
  service              Service           @relation(fields: [serviceId], references: [id])

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([startTime])
}

model TimeBlock {
  id          String   @id @default(uuid())
  startTime   DateTime
  endTime     DateTime
  reason      String?
  isRecurring Boolean  @default(false)
  recurrence  String?  
  isFullDay   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model BusinessHour {
  id        String   @id @default(uuid())
  dayOfWeek Int      @unique
  isOpen    Boolean  @default(true)
  openTime  String   @default("10:00")
  closeTime String   @default("19:00")
  breakStart String? 
  breakEnd   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id         String    @id @default(uuid())
  endpoint   String    @unique
  p256dh     String
  auth       String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}